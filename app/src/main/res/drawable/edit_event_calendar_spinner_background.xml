<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true"
        android:drawable="@drawable/pressed_color_shape"/>
    <item android:state_selected="true">
        <shape>
            <stroke
                android:width="@dimen/focused_border_width"
                android:color="@color/focused_border_color"/>
            <solid android:color="@color/edit_event_calendars_background"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/white"/>
        </shape>
    </item>
</selector>
