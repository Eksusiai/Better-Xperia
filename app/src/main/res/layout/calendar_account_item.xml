<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true">
    <TextView
        android:textSize="@dimen/drawer_text_size_title"
        android:textColor="@color/actionbar_big_text_color"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/typeLabel"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <TextView
        android:textSize="@dimen/drawer_text_size_subtext"
        android:textColor="@color/actionbar_small_text_color"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/displayLabel"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:singleLine="true"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
</LinearLayout>
