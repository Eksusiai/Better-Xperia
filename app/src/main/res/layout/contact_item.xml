<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/contact_name_type"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/event_detail_item_height"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.sonymobile.calendar.widget.RoundedQuickContactBadge
            android:layout_gravity="center_horizontal"
            android:id="@+id/badge"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/attendee_badge_width"
            android:layout_height="@dimen/attendee_badge_height"
            android:layout_margin="4dp"
            android:src="@drawable/contact_badge"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/linkediin_small_logo"
            android:background="@drawable/linkedin_logo_background"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="7dp"
            android:src="@drawable/ic_linkedin_brand"
            android:scaleType="centerInside"
            android:layout_marginStart="-19dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/meeting_response_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_invite_maybe"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="center"
        style="@style/TextAppearance.AppCompat.Caption"/>
</LinearLayout>
