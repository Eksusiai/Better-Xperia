<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/date_switcher_container"
    android:background="@android:color/transparent"
    android:paddingTop="@dimen/date_switcher_padding_top"
    android:paddingBottom="@dimen/date_switcher_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="@dimen/date_switcher_height"
    android:layout_marginStart="@dimen/date_switcher_margin_horizontal"
    android:layout_marginEnd="@dimen/date_switcher_margin_horizontal">
    <ImageView
        android:id="@+id/date_switcher_prev_btn"
        android:background="@drawable/header_base_selector"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_previous"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_toStartOf="@+id/date_switcher_next_btn"
        android:layout_toEndOf="@+id/date_switcher_prev_btn">
        <TextView
            android:ellipsize="end"
            android:id="@+id/date_switcher_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/DateSwitcherTextStyle"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textSize="10dp"
            android:id="@+id/date_switcher_holiday_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/date_switcher_next_btn"
        android:background="@drawable/header_base_selector"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_next"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
