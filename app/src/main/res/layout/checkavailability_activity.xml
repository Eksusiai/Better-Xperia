<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mm"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:layout_alignParentTop="true"
        app:layout_scrollFlags="enterAlways"
        style="@style/ToolbarDark"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/new_event_availability_date_txt"
            android:gravity="start"
            android:id="@+id/date"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="126dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="27dp"
            android:layout_width="126dp"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/ic_availability_title_bg"
                android:layout_width="match_parent"
                android:layout_height="23dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/new_event_availability_txt"
                    android:gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_attendees_availability_label"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
            <com.sonymobile.calendar.CalendarScrollView
                android:id="@+id/svl"
                android:scrollbars="none"
                android:layout_width="126dp"
                android:layout_height="match_parent"
                android:overScrollMode="never">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/attendees"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.sonymobile.calendar.CalendarScrollView>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <HorizontalScrollView
                android:id="@+id/hsv"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:paddingStart="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ScrollView
                        android:id="@+id/timeScrollView"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="50dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/timeContainer"
                                android:layout_width="match_parent"
                                android:layout_height="27dp"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="23dp">
                                <ImageView
                                    android:id="@+id/allStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="23dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                    <com.sonymobile.calendar.CalendarScrollView
                        android:id="@+id/svr"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never">
                        <ImageView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </com.sonymobile.calendar.CalendarScrollView>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/divider_shadow_v"
                    android:paddingTop="2dp"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/divider_shadow_vertical"
                    android:scaleType="fitXY"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
