<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/where"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/event_detail_item_height"
        android:drawablePadding="@dimen/event_detail_item_drawable_padding"
        android:drawableStart="@drawable/ic_location"
        android:paddingStart="@dimen/event_detail_item_margin_start"
        android:paddingEnd="@dimen/event_detail_item_margin_end"
        style="@style/EventDetailViewStyle.Body.Regular"/>
    <RelativeLayout
        android:id="@+id/map_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/location_layout_height"
        android:layout_marginTop="@dimen/location_layout_top"
        android:layout_marginBottom="@dimen/location_layout_bottom"
        android:layout_marginStart="@dimen/location_layout_start"
        android:layout_marginEnd="@dimen/location_layout_end">
        <Button
            android:theme="@style/WhiteButton"
            android:id="@+id/navigation"
            android:layout_width="@dimen/location_navigation_button_width"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            style="@style/NavigationButton"/>
        <FrameLayout
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/button_inset_vertical_material"
            android:layout_marginBottom="@dimen/button_inset_vertical_material"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/navigation"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</merge>
