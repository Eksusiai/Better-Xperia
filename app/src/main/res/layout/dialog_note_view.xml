<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layoutDirection="locale">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/new_event_availability_dialog_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/availability_info_ooo"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:src="@color/tablet_new_event_availability_oof"
                android:layout_centerVertical="true"
                android:contentDescription="@string/availability_info_ooo"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/new_event_availability_dialog_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layoutDirection="locale">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/new_event_availability_dialog_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/availability_info_busy"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:src="@color/tablet_new_event_availability_busy"
                android:layout_centerVertical="true"
                android:contentDescription="@string/availability_info_busy"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/new_event_availability_dialog_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layoutDirection="locale">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/new_event_availability_dialog_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/availability_info_tentative"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:src="@color/tablet_new_event_availability_tent"
                android:layout_centerVertical="true"
                android:contentDescription="@string/availability_info_tentative"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/new_event_availability_dialog_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layoutDirection="locale">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/new_event_availability_dialog_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/availability_info_no_info"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:src="@color/tablet_new_event_availability_noin"
                android:layout_centerVertical="true"
                android:contentDescription="@string/availability_info_no_info"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
