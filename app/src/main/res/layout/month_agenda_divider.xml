<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/agenda_divider_parent"
    android:background="@drawable/agenda_header_background"
    android:focusable="true"
    android:nextFocusRight="@+id/weatherIcon"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/agenda_month_divider_item_height"
            android:layout_toStartOf="@+id/weatherIcon"
            android:layout_alignParentStart="true">
            <TextView
                android:id="@+id/dayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textAlignment="viewStart"
                android:layout_marginStart="15dp"
                style="@style/MonthAgendaDivider_DayText"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/holidayLabel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="15dp"/>
        </LinearLayout>
        <com.sonymobile.calendar.weather.WeatherIcon
            android:id="@+id/weatherIcon"
            android:background="@drawable/day_week_event_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="2dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:src="@drawable/divider_horizontal_bright"
        android:scaleType="fitXY"/>
</LinearLayout>
