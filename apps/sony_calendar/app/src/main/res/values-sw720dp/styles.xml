<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DateSwitcherTextStyle" parent="">
        <item name="android:textSize">@dimen/calendar_day_header_text_size</item>
        <item name="android:textColor">@color/navigation_month_grid_item_text_color</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="EditEventButtonStyle" parent="@style/Theme.AppCompat.Light">
        <item name="android:textSize">@dimen/event_view_button_text_size</item>
<item name="android:gravity">center</item>
<item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">5dp</item>
    </style>
    <style name="EditEventEditTextStyle" parent="@style/TextAppearance.AppCompat.Medium">
        <item name="android:textColorHint">@color/edit_event_text_hint_color</item>
<item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">160dp</item>
<item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
<item name="android:capitalize">sentences</item>
<item name="android:imeOptions">actionNext</item>
<item name="android:textAlignment">viewStart</item>
    </style>
    <style name="EditEventLabelStyle" parent="@style/TextAppearance.AppCompat.Medium">
<item name="android:gravity">end|center_vertical</item>
        <item name="android:layout_width">160dp</item>
<item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:layout_centerInParent">true</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <style name="EditEventSpinnerStyle" parent="">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
    </style>
    <style name="Snap_MonthView_DayLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Medium</item>
<item name="android:gravity">center</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:layout_width">29dp</item>
<item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TabletHeaderText" parent="">
        <item name="android:textSize">@dimen/header_text_size</item>
<item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:layout_marginTop">@dimen/header_text_margin_top</item>
        <item name="android:layout_marginStart">@dimen/header_text_margin_start</item>
    </style>
    <style name="TextAppearance.EditEvent_homeTime" parent="@style/TextAppearance">
        <item name="android:textSize">@dimen/event_view_timezone_text_size</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:paddingEnd">2dp</item>
    </style>
    <style name="tablet_default_background_color" parent="">
        <item name="android:background">?android:attr/colorBackground</item>
    </style>
</resources>
