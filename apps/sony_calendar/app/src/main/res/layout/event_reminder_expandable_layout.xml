<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/event_reminder_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/expand_reminder_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_down"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/event_reminder_header_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_detail_item_height"
            android:drawablePadding="@dimen/event_detail_item_drawable_padding"
            android:drawableStart="@drawable/ic_snooze"
            android:paddingStart="@dimen/event_detail_item_margin_start"
            android:paddingEnd="@dimen/event_detail_item_margin_end"
            android:layout_toStartOf="@+id/expand_reminder_icon"
            android:layout_alignParentStart="true"
            style="@style/EventDetailViewStyle.Body.Regular"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/event_reminder_expandable_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/event_reminder_header"/>
</merge>
