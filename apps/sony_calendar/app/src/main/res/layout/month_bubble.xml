<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bubble_layout"
    android:paddingTop="5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="10dp">
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shrinkColumns="1">
        <TableRow android:id="@+id/item_layout0">
            <TextView
                android:textColor="@color/panel_text_foreground"
                android:id="@+id/time0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="10dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/panel_text_foreground"
                android:ellipsize="end"
                android:id="@+id/event_title0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </TableRow>
        <TableRow android:id="@+id/item_layout1">
            <TextView
                android:textColor="@color/panel_text_foreground"
                android:id="@+id/time1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="10dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/panel_text_foreground"
                android:ellipsize="end"
                android:id="@+id/event_title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </TableRow>
        <TableRow android:id="@+id/item_layout2">
            <TextView
                android:textColor="@color/panel_text_foreground"
                android:id="@+id/time2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="10dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/panel_text_foreground"
                android:ellipsize="end"
                android:id="@+id/event_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </TableRow>
        <TableRow android:id="@+id/item_layout3">
            <TextView
                android:textColor="@color/panel_text_foreground"
                android:id="@+id/time3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="10dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/panel_text_foreground"
                android:ellipsize="end"
                android:id="@+id/event_title3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </TableRow>
    </TableLayout>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/panel_text_foreground"
        android:id="@+id/plus_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</LinearLayout>
