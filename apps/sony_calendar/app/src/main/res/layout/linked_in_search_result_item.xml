<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <ImageView
        android:id="@+id/item_connect_on_linkedin"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add_linkedin"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toStartOf="@+id/item_connect_on_linkedin"
        android:layout_toEndOf="@+id/linkedin_contact_profile_pic_layout">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:id="@+id/linkedin_search_result_connection_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="caption"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:id="@+id/linkedin_search_result_contact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/linkedin_search_result_connection_number"
                style="@style/LinkedInHeaderTextBold"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/linkedin_search_result_contact_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="false"
            style="@style/LinkedInHeaderText"/>
        <TextView
            android:id="@+id/linkedin_search_result_contact_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LinkedInHeaderText"/>
        <TextView
            android:id="@+id/linkedin_search_result_contact_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LinkedInHeaderText"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linkedin_contact_profile_pic_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <com.sonymobile.calendar.widget.RoundedQuickContactBadge
            android:layout_gravity="center_horizontal"
            android:id="@+id/linkedin_search_result_contact_image"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/contact_badge"
            android:scaleType="centerCrop"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/linkediin_small_logo_view"
            android:background="@drawable/linkedin_logo_background"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="7dp"
            android:src="@drawable/ic_linkedin_brand"
            android:scaleType="centerInside"
            android:layout_marginStart="-19dp"/>
    </LinearLayout>
</RelativeLayout>
