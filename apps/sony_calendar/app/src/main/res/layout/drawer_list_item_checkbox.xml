<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/drawer_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/drawer_layout_item_min_height">
    <CheckBox
        android:id="@+id/checkbox"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toStartOf="@+id/color_indicator"
        android:layout_toEndOf="@+id/checkbox">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/drawer_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginBottom="-2dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/drawer_subtext"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="-2dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/color_indicator"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_colorpallet"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
