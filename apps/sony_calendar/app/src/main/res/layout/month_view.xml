<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.sonymobile.calendar.MonthAgendaTransitionView
            android:id="@+id/transition_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.sonymobile.calendar.CalendarSwipeView
            android:id="@+id/calendar_swipe_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <com.sonymobile.calendar.CalendarColumnsLayout
                android:orientation="horizontal"
                android:id="@+id/calendar_columns_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.sonymobile.calendar.CalendarSwipeView>
    </FrameLayout>
</merge>
