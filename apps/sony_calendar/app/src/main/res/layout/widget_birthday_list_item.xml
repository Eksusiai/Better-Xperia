<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/content"
    android:layout_width="match_parent"
    android:layout_height="@dimen/agenda_item_height">
    <RelativeLayout
        android:id="@+id/birthday_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="locale">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/birthday_title_container"
            android:paddingTop="@dimen/widgetTopBottomPadding"
            android:paddingBottom="@dimen/widgetTopBottomPadding"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/widgetStartEndPadding"
            android:paddingEnd="@dimen/widgetStartEndPadding"
            android:layout_toStartOf="@+id/photoFrames"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/birthday_cake_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_birthday_white"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/birthday_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/widgetStartEndPadding"
                android:paddingEnd="@dimen/widgetStartEndPadding"
                android:layout_toEndOf="@+id/birthday_cake_icon"
                style="@style/TextAppearance.AgendaItem_TitleValue"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/photoFrames"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/doublePhotoFrame"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="56dp"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/doublePhotoSlot1"
                    android:visibility="invisible"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:contentDescription="@null"
                    android:layout_marginStart="2dp"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/doublePhotoSlot2"
                    android:visibility="visible"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@null"
                    android:layout_toStartOf="@+id/doublePhotoSlot1"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/quadPhotoFrame"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/quadPhotoSlot1"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@null"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/quadPhotoSlot2"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:layout_toStartOf="@+id/quadPhotoSlot1"/>
                <ImageView
                    android:id="@+id/quadPhotoSlot3"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:src="@drawable/ic_more_small"
                    android:layout_below="@+id/quadPhotoSlot1"
                    android:layout_toStartOf="@+id/quadPhotoSlot4"/>
                <ImageView
                    android:id="@+id/quadPhotoSlot4"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:layout_below="@+id/quadPhotoSlot2"
                    android:contentDescription="@null"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/horizontal_line"
            android:background="@color/widget_divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_separator_line_width"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
    </RelativeLayout>
</LinearLayout>
