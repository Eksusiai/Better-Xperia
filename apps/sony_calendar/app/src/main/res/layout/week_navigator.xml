<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/week_number_layout"
            android:layout_width="@dimen/calendar_left_panel_width"
            android:layout_height="match_parent">
            <View
                android:id="@+id/week_line"
                android:background="@color/calendar_grid_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="@dimen/month_view_tablet_grid_padding"/>
            <TextView
                android:textSize="@dimen/day_label_week_number"
                android:gravity="center"
                android:id="@+id/week_navigator_week_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <com.sonymobile.calendar.CalendarSwipeView
            android:id="@+id/calendar_swipe_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.sonymobile.calendar.CalendarColumnsLayout
                android:orientation="horizontal"
                android:id="@+id/calendar_columns_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.sonymobile.calendar.CalendarSwipeView>
    </LinearLayout>
</merge>
