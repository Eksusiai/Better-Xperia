<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector android:drawable="@color/calendar_grid_area_background">
            <item
                android:state_selected="true"
                android:state_pressed="false">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="@color/focused_border_color"/>
                    <gradient
                        android:startColor="@color/calendar_grid_area_background"
                        android:endColor="@color/calendar_grid_area_background"
                        android:angle="0"/>
                </shape>
            </item>
            <item
                android:state_enabled="true"
                android:drawable="@color/calendar_grid_area_background"/>
        </selector>
    </item>
</ripple>
