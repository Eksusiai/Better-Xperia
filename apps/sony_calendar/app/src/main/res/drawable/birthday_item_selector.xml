<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <stroke
                        android:width="@dimen/focused_border_width"
                        android:color="@color/focused_border_color"/>
                    <solid android:color="@color/birthdayBackgroundPanelColor"/>
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <stroke
                        android:width="@dimen/focused_border_width"
                        android:color="@color/focused_border_color"/>
                </shape>
            </item>
            <item
                android:state_pressed="true"
                android:drawable="@drawable/pressed_color_shape"/>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
