<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ic_account_bg"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="6dp">
    <ImageView
        android:id="@+id/account_indicator"
        android:layout_width="@dimen/account_indicator_width"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:src="@drawable/calendar_indicator"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/tablet_account_text_color"
            android:ellipsize="marquee"
            android:id="@+id/calendar"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="?android:attr/textAppearanceMedium"/>
    </LinearLayout>
    <CheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/visible_check_box"
        android:focusable="false"
        android:clickable="false"
        android:longClickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="5dp"/>
</LinearLayout>
